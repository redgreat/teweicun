# 默认忽略全部，按需放行构建所需内容
*

# 后端构建必需
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**
!pkg/
!pkg/**
!configs/
!configs/**

# 前端构建必需
!frontend/
!frontend/**

# 前端目录中的无关/可再生成内容
frontend/node_modules/
frontend/build/
frontend/.svelte-kit/
frontend/dist/
frontend/coverage/
frontend/.env
frontend/.env.*
frontend/*.log

# 通用临时/编辑器文件
**/.DS_Store
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*.swn
**/*.tmp
**/*.bak
**/*.cache